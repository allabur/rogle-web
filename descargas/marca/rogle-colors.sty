\definecolor{rogleGrisUPV431}{HTML}{5B6770}
\definecolor{rogleSeparador}{HTML}{CFCFCF}
% Status
\definecolor{rogleGreen}{HTML}{2E8B57}
\definecolor{rogleRed}{HTML}{C8423B}

% Aliases of the former proposal names, so existing documents keep compiling
\colorlet{rogle20OxfordBlue}{rogleOxfordBlue}
\colorlet{rogle20Indigo}{rogleIndigo}
