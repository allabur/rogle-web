% ROGLE brand colours for LaTeX. Mirror of the palette in _brand.yml: keep both in sync.
% Current brand: 20th-anniversary proposal, alternative A adopted for the time being.
% Usage: \usepackage{rogle-colors}  ->  \color{rogleIndigo}, \colorbox{rogleIndigoClaro!20}{...}
% Amber rule: only for the "20" mark and on Oxford Blue.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rogle-colors}[2026/10/01 ROGLE brand colours]
\RequirePackage{xcolor}

% Current brand
\definecolor{rogleOxfordBlue}{HTML}{002147}
\definecolor{rogleIndigo}{HTML}{3F4AA8}
